            "complex_modifications": {
                "rules": [
                    {
                        "description": "Right Command VIM layer with full modifier control",
                        "manipulators": [
                            {
                                "description": "Right Cmd → activate VIM layer",
                                "from": {
                                    "key_code": "right_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    { "set_variable": { "name": "vim_arrows", "value": 1 } }
                                ],
                                "to_after_key_up": [
                                    { "set_variable": { "name": "vim_arrows", "value": 0 } }
                                ],
                                "to_if_alone": [
                                    { "key_code": "right_command" }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Left Cmd (while VIM layer) → consume and set cmd flag",
                                "conditions": [
                                    { "type": "variable_if", "name": "vim_arrows", "value": 1 }
                                ],
                                "from": {
                                    "key_code": "left_command",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    { "set_variable": { "name": "vim_cmd", "value": 1 } }
                                ],
                                "to_after_key_up": [
                                    { "set_variable": { "name": "vim_cmd", "value": 0 } }
                                ],
                                "type": "basic"
                            },

                            {
                                "description": "VIM+Cmd+H → Ctrl+A (beginning of line)",
                                "conditions": [
                                    { "type": "variable_if", "name": "vim_arrows", "value": 1 },
                                    { "type": "variable_if", "name": "vim_cmd", "value": 1 }
                                ],
                                "from": { "key_code": "h", "modifiers": { "optional": ["any"] } },
                                "to": [{ "key_code": "a", "modifiers": ["left_control"] }],
                                "type": "basic"
                            },
                            {
                                "description": "VIM+Cmd+L → Ctrl+E (end of line)",
