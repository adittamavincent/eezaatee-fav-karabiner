                                    { "type": "variable_if", "name": "vim_arrows", "value": 1 },
                                    { "type": "variable_if", "name": "vim_cmd", "value": 1 }
                                ],
                                "from": { "key_code": "l", "modifiers": { "optional": ["any"] } },
                                "to": [{ "key_code": "e", "modifiers": ["left_control"] }],
                                "type": "basic"
                            },
                            {
                                "description": "VIM+Cmd+J → Cmd+Down (bottom of document)",
